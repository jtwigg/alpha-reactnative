{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @rn-monorepo/reactnative export:web",
  "outputDirectory": "packages/reactnative/dist",
  "cleanUrls": true,
  "functions": {
    "api/mcp.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/((?!_expo(?:/|$)|assets(?:/|$)|api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
