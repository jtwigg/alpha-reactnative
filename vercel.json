{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @rn-monorepo/reactnative export:web",
  "outputDirectory": "packages/reactnative/dist",
  "cleanUrls": true,
  "functions": {
    "api/mcp.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!_expo(?:/|$)|assets(?:/|$)|api(?:/|$)|\\.well-known(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
