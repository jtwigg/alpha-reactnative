# Copy the values you need into:
#   packages/reactnative/.env.local   (Expo web + native)
#   Convex dashboard env vars         (backend)
#   Vercel project env vars           (web production)
#   EAS secrets                       (iOS / Android builds)
#
# Frontend (Expo / Vercel / EAS)
EXPO_PUBLIC_CONVEX_URL=https://YOUR_DEPLOYMENT.convex.cloud
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_KEY
#
# Backend (Convex dashboard)
CLERK_JWT_ISSUER_DOMAIN=https://YOUR_INSTANCE.clerk.accounts.dev
OPENAI_API_KEY=
#
# Optional CI / Vercel Convex deploy
# CONVEX_DEPLOY_KEY=
#
# Optional native identifiers
# IOS_BUNDLE_IDENTIFIER=com.example.johnsapp
# ANDROID_PACKAGE=com.example.johnsapp
# EAS_PROJECT_ID=
# EXPO_OWNER=
