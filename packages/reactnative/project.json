{
  "name": "reactnative",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/reactnative",
  "projectType": "application",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "packages/reactnative"
      }
    },
    "export:web": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ./scripts/write-app-links.mjs && expo export --platform web && node ./scripts/write-app-links.mjs --out dist",
        "cwd": "packages/reactnative"
      }
    },
    "update:preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./scripts/eas-update.sh preview",
        "cwd": "packages/reactnative"
      }
    },
    "update:production": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./scripts/eas-update.sh production",
        "cwd": "packages/reactnative"
      }
    },
    "ios:testflight": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./scripts/ios-testflight.sh",
        "cwd": "packages/reactnative"
      }
    },
    "check:native": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node ./scripts/check-native.mjs",
        "cwd": "packages/reactnative"
      }
    }
  },
  "tags": []
}
