# Clerk publishable key for app_3L3Yo0NESQ48He3AynMeLsx1HTA (public; committing is fine).
# Starts with pk_test_ (dev) or pk_live_ (prod).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YXdhaXRlZC1qZW5uZXQtMjc2MC5jbGVyay5hY2NvdW50cy5kZXYk

# Optional App Store / EAS overrides (also set as EAS secrets)
