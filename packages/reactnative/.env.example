# Convex deployment URL (Dashboard → Settings → URL). Ends in .convex.cloud
EXPO_PUBLIC_CONVEX_URL=https://YOUR_DEPLOYMENT.convex.cloud

# Clerk publishable key (Dashboard → API Keys). Starts with pk_test_ or pk_live_
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_KEY

# Optional App Store / EAS overrides (also set as EAS secrets)
# IOS_BUNDLE_IDENTIFIER=com.yourname.johnsapp
# ANDROID_PACKAGE=com.yourname.johnsapp
# EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000
# EXPO_OWNER=your-expo-username
