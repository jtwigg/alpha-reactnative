# Convex CLI (packages/server). Team john-twigg, project alpha.
CONVEX_DEPLOYMENT=dev:posh-mink-581

# Set these on the Convex dashboard (Settings → Environment Variables)
# for the posh-mink-581 development deployment (and production later).

# Clerk Frontend API URL for app_3L3Yo0NESQ48He3AynMeLsx1HTA.
# Clerk Dashboard → Convex integration (session token aud=convex). No JWT template.
CLERK_JWT_ISSUER_DOMAIN=https://awaited-jennet-2760.clerk.accounts.dev

# App-wide allowlist (Convex dashboard). Default-deny if both are unset.
# Comma-separated, case-insensitive emails from the Clerk session `email` claim.
ALLOWED_EMAILS=john.twigg@gmail.com
# Fallback if the session token has no email claim (Clerk Dashboard → Users → user_…).
# ALLOWED_USER_IDS=

# Optional. Existing chat + Whisper features.
OPENAI_API_KEY=

# Used by CI / Vercel if you wrap the web build with `npx convex deploy`.
# Convex Dashboard → Settings → Deploy Key
# CONVEX_DEPLOY_KEY=
