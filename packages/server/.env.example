# Set these on the Convex dashboard (Settings → Environment Variables)
# for BOTH the development and production deployments.

# Clerk Frontend API URL (Dashboard → API Keys → Frontend API URL)
# Dev:  https://verb-noun-00.clerk.accounts.dev
# Prod: https://clerk.yourdomain.com
CLERK_JWT_ISSUER_DOMAIN=

# Optional. Existing chat + Whisper features.
OPENAI_API_KEY=

# Used by CI / Vercel if you wrap the web build with `npx convex deploy`.
# Convex Dashboard → Settings → Deploy Key
# CONVEX_DEPLOY_KEY=
